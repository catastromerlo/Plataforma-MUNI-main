# ============================================================================
#  CONFIGURACION DEL VISOR CATASTRAL - VILLA DE MERLO
# ============================================================================
#
#  COMPLETAR LAS CUATRO PRIMERAS LINEAS con los datos de conexion a la base
#  municipal, guardar (Ctrl+G) y cerrar.
#
#  Si no tenes esos datos, pediselos a quien administre el sistema de catastro.
#
#  Las lineas que empiezan con # son comentarios: no hace falta tocarlas.
#  Este archivo tiene la contrasena de la base: no compartirlo ni subirlo a
#  ningun lado.
#
# ============================================================================


# --- DATOS DE CONEXION (completar) ------------------------------------------

# Nombre del equipo donde esta la base, o su direccion IP.
# Conviene el nombre y no la IP: si el servidor cambia de direccion, el nombre
# sigue funcionando.
DB_SERVER=completar

# Nombre de la base de datos.
DB_DATABASE=completar

# Usuario y contrasena de la base.
DB_USER=completar
DB_PASSWORD=completar


# --- DE ACA PARA ABAJO NO HACE FALTA TOCAR NADA -----------------------------

# Cifrado de la conexion. En false porque el servidor municipal todavia no lo
# admite. Si algun dia lo habilitan, pasar a true.
DB_ENCRYPT=false
DB_TRUST_CERT=true

# Puerto en el que queda escuchando este visor: 8002, fijo.
#
# NO hace falta tocarlo. Tanto el Servicio de Windows (que instala
# INSTALAR.bat) como INICIAR.bat en modo manual definen el puerto 8002 por su
# cuenta al arrancar, y eso tiene prioridad sobre lo que diga este archivo.
#
# Lo que figure aca solo se usa si alguien ejecuta "node server.js" a mano,
# sin pasar por ninguno de los dos. Por eso conviene dejarlo en 8002: asi
# todas las formas de abrir el visor coinciden en la misma direccion,
# http://localhost:8002
PORT=8002

# Cantidad maxima de parcelas que devuelve una busqueda por filtros.
MAX_ROWS=5000

# Limite de consultas por minuto, para que nadie pueda descargar el padron
# entero de forma automatica.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100


# --- ACCESO REMOTO (opcional, ver docs/acceso-remoto.md) --------------------
#
# Estas tres NO se tocan para el uso normal en la Municipalidad. Sirven solo si
# se quiere que el visor sea accesible desde fuera de la red municipal, a
# traves de un tunel con candado (Cloudflare). Dejarlas vacias o comentadas
# mientras no sea el caso.

# A que interfaz de red escucha el servidor.
#   vacio  -> todas (lo normal: se abre en esta compu y en la red de la Muni)
#   127.0.0.1 -> solo esta computadora. Se usa con el tunel: asi la API no
#                queda expuesta a la red, solo la alcanza el tunel.
# HOST=127.0.0.1

# Origenes autorizados a consultar la API desde el navegador, separados por
# coma. SOLO hace falta si el frente se publica aparte (Vercel). Si el tunel
# sirve todo junto (lo recomendado), dejar esto vacio.
# NUNCA poner "*": abriria el padron a cualquier pagina de internet.
# ORIGENES_PERMITIDOS=https://catastro-merlo.vercel.app


# --- TITULAR DE PROPIEDAD HORIZONTAL POR PADRON (opcional) ------------------
#
# Las sub-unidades de PH de la numero 20 en adelante no tienen nomenclatura
# propia en el plano, asi que su ficha queda sin titular. Activando esto, esos
# casos se resuelven buscando el titular por NRO_RENTA en vez de por
# nomenclatura.
#
# ANTES DE ACTIVARLO hay que confirmar que la vista VI_CPAR_PROPIETARIOS tenga
# una columna NRO_RENTA (correr herramientas/consultas-pendientes.sql). Si no
# la tiene, dejar esto apagado: no rompe nada, pero tampoco sirve.
# PH_TITULAR_POR_PADRON=true

# ----------------------------------------------------------------------------
#  MODO DE PRUEBA
#
#  En false, que es como tiene que quedar en la Municipalidad: el visor muestra
#  los datos reales de la base, y si no puede conectarse lo dice claramente.
#
#  En true, cuando NO hay conexion, el visor inventa datos para poder probar la
#  pantalla. Sirve para desarrollar desde una computadora fuera de la red
#  municipal. Los datos inventados aparecen siempre marcados en pantalla y en
#  la plancheta, pero aun asi: no dejarlo en true en una computadora de trabajo.
# ----------------------------------------------------------------------------
MODO_DEMO=false
